{
  "name": "softw-codespaces",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-20-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "forwardPorts": [3001, 8080],
  "portsAttributes": {
    "3001": {
      "label": "Softw backend API",
      "onAutoForward": "notify",
      "visibility": "public"
    },
    "8080": {
      "label": "Softw container frontend",
      "onAutoForward": "silent",
      "visibility": "private"
    }
  },
  "postStartCommand": "sh 03_devops/scripts/codespace-start.sh",
  "remoteUser": "node"
}
