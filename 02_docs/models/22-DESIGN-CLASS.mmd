classDiagram
  class AuthPage { +submitRegister(); +submitLogin() }
  class SearchPage { +loadProducts(filters) }
  class ProductDetailPage { +loadProduct(id); +handleAddToCart() }
  class CheckoutPage { +submitOrder() }
  class ShopPage { +submitVerification(); +saveShop() }
  class EvaluationPage { +submitEvaluation() }
  class ChatPage { +sendText(); +sendBargain(); +decideRequest() }
  class AddressManager { +loadAddresses(); +saveAddresses() }
  class ApiClient { +request(config); +attachJwt() }
  class CartSlice { +addToCart(); +updateQuantity(); +removeFromCart(); +clearCart() }
  class UserController { +register(); +login(); +getUserProfile(); +updatePassword() }
  class ProductController { +getProducts(); +getProductDetail(); +createProduct(); +updateProduct() }
  class OrderController { +createOrder(); +cancelOrder(); +payOrder(); +shipOrder(); +confirmOrder() }
  class ShopController { +getMyShop(); +submitShopVerification(); +updateMyShop() }
  class EvaluationController { +createEvaluation(); +replyEvaluation() }
  class ChatController { +createOrGetConversation(); +sendMessage(); +decideRequest() }
  class AddressController { +getAddresses(); +replaceAddresses() }
  class User { +id; +email; +password; +creditScore; +matchPassword() }
  class Product { +id; +sellerId; +price; +stock; +status; +isSecondhand }
  class Order { +id; +userId; +items; +status; +paymentStatus; +logisticsInfo }
  class Shop { +id; +userId; +verificationStatus; +status }
  class Evaluation { +id; +orderId; +productId; +rating; +reply }
  class Address { +id; +userId; +name; +phone; +isDefault }
  class ChatConversation { +id; +buyerId; +sellerId; +productId }
  class ChatMessage { +id; +conversationId; +type; +amount; +requestStatus }
