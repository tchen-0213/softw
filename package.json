{
  "name": "shopping-platform-practice",
  "version": "1.0.0",
  "private": true,
  "description": "软件工程基础实践交付脚本入口",
  "scripts": {
    "test": "npm --prefix backend test && npm --prefix frontend run test:unit",
    "test:api": "npm --prefix backend run test:api",
    "test:services": "node 04_tests/microservices/run-service-integration.js",
    "test:services:direct": "npm --prefix services/user-service test && npm --prefix services/product-service test && npm --prefix services/order-service test && npm --prefix services/api-gateway test",
    "test:services:unit": "node --test services/api-gateway/common.test.js services/api-gateway/validation.test.js services/product-service/upload-security.test.js 04_tests/microservices/public-api-coverage.test.js",
    "test:services:inventory": "node --test 04_tests/microservices/public-api-coverage.test.js",
    "test:services:api": "node --test 04_tests/microservices/public-api-coverage.test.js 04_tests/microservices/api-e2e.test.js",
    "test:security": "node --test 04_tests/security/config-security.test.js && node 04_tests/security/run-security-scan.js",
    "test:experiments": "node --test 04_tests/performance/hpa-fault-config.test.js",
    "test:delivery": "node --test 04_tests/security/config-security.test.js 04_tests/performance/hpa-fault-config.test.js 04_tests/performance/evidence-completeness.test.js 04_tests/deployment/packaging.test.js",
    "test:readiness-recovery": "node 04_tests/security/readiness-recovery.js",
    "test:trace-evidence": "node 04_tests/security/trace-evidence.js",
    "test:e2e": "npm --prefix frontend run test:e2e",
    "build": "npm --prefix frontend run build",
    "verify": "npm run test && npm run test:services:unit && npm run test:delivery && npm --prefix frontend run lint && npm run build",
    "verify:full": "npm run verify && npm run test:services",
    "db:migrate": "npm --prefix backend run db:migrate",
    "db:migrate:status": "npm --prefix backend run db:migrate:status",
    "env:init": "sh 03_devops/scripts/init-local-env.sh",
    "compose:up": "docker compose --env-file .env -f 03_devops/docker-compose.yml up --build",
    "compose:down": "docker compose --env-file .env -f 03_devops/docker-compose.yml down -v",
    "k8s:monolith": "kubectl apply -f 03_devops/k8s/monolith",
    "k8s:microservices": "kubectl apply -f 03_devops/k8s/microservices",
    "k8s:deploy": "sh 03_devops/scripts/deploy-k8s.sh",
    "k8s:rollback": "sh 03_devops/scripts/rollback-k8s.sh",
    "k8s:observe": "sh 03_devops/scripts/k8s-observe-microservices.sh",
    "experiment:hpa": "sh 03_devops/scripts/run-hpa-experiment.sh",
    "experiment:fault": "sh 03_devops/scripts/run-fault-isolation-experiment.sh",
    "perf:compare": "bash 03_devops/scripts/run-performance-comparison.sh",
    "perf:orders": "npm --prefix services/order-service run benchmark:query",
    "perf:indexes": "npm --prefix services/order-service run evidence:indexes",
    "perf:k6": "k6 run -e BASE_URL=${BASE_URL:-http://localhost:3001} 04_tests/performance/k6-core-flow.js"
  }
}
