{
  "name": "shopping-platform-backend",
  "version": "1.0.0",
  "description": "购物与二手交易平台后端服务",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "test": "cross-env NODE_ENV=test node --test",
    "test:api": "cross-env RUN_API_E2E=1 node --test tests/api-flow.test.js",
    "db:migrate": "node scripts/migrate.js up",
    "db:migrate:status": "node scripts/migrate.js status",
    "db:migrate:down": "node scripts/migrate.js down",
    "seed": "node seedDemoProducts.js",
    "seed:scenario": "node seedDemoScenario.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.6.5",
    "sequelize": "^6.35.0"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "nodemon": "^3.0.2"
  }
}
